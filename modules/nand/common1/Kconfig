choice
	prompt "choice spinand or rawnand"
	depends on (SUNXI_NAND)

	config SUNXI_RAWNAND
		bool "sunxi raw nand driver"

	config	SUNXI_SPINAND
		bool "sunxi spi nand driver"

endchoice

config TRIMUI_NFTL_RECOVERED_C
	bool "Build verified NFTL helper bodies from C"
	depends on SUNXI_NAND && ARM64
	default n
	help
	  Replace six separately verified NFTL assembly bodies with C.
	  The stock configuration leaves this
	  disabled so the retained assembly continues to reproduce its layout.
