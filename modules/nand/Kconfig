config SUNXI_NAND
	tristate  "The sunxi nand driver"
	default n
	help
	  The nand used on the platform.

	  If unsure, say m.
source "modules/nand/common1/Kconfig"

config SUNXI_NAND_IOCTL_SECBLK
	bool "Support ioctl for NAND secure storage items"
	depends on SUNXI_NAND
	default y
	help
	  Enable the SECBLK_READ, SECBLK_WRITE and SECBLK_IOCTL interface.
