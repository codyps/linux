config SUNXI_NAND
	tristate  "The sunxi nand driver"
	default n
	help
	  The nand used on the platform.

	  If unsure, say m.
source "modules/nand/common1/Kconfig"

config SUNXI_NAND_IOCTL_SECBLK
	bool "Support ioctl for NAND secure storage items"
	depends on SUNXI_NAND
	default y
	help
	  Enable the SECBLK_READ, SECBLK_WRITE and SECBLK_IOCTL interface.

# #860 records this optional feature disabled. Its declaration is recovered
# from configuration evidence; the optional implementation is unverified.
config SUNXI_NAND_IOCTL_SECKV
	bool "NAND secure storage key/value (stock metadata only)"
	depends on SUNXI_NAND
	default n
	help
	  This declaration reproduces the disabled stock option. The optional
	  driver is outside the reconstructed TG3040 configuration and is not
	  verified or supported by this reconstruction. Leave it disabled.
